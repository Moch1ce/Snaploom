{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Snaploom",
  "version": "0.1.0",
  "identifier": "com.snaploom.desktop",
  "build": {
    "beforeDevCommand": "pnpm --dir web/desktop-settings dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm --dir web/desktop-settings build",
    "frontendDist": "../../../web/desktop-settings/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Snaploom",
        "width": 760,
        "height": 540,
        "resizable": true
      }
    ],
    "macOSPrivateApi": false,
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost"
    }
  },
  "bundle": {
    "active": false,
    "macOS": {
      "minimumSystemVersion": "14.0",
      "infoPlist": "Info.plist"
    }
  }
}
