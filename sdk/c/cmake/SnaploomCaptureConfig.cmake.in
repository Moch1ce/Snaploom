get_filename_component(_SNAPLOOM_CAPTURE_PREFIX
  "${CMAKE_CURRENT_LIST_DIR}/../../.." ABSOLUTE)

if(NOT TARGET Snaploom::Capture)
  add_library(Snaploom::Capture SHARED IMPORTED)
  if(WIN32)
    set_target_properties(Snaploom::Capture PROPERTIES
      IMPORTED_LOCATION "${_SNAPLOOM_CAPTURE_PREFIX}/bin/snaploom_capture.dll"
      IMPORTED_IMPLIB "${_SNAPLOOM_CAPTURE_PREFIX}/lib/snaploom_capture.lib")
  elseif(APPLE)
    set_target_properties(Snaploom::Capture PROPERTIES
      IMPORTED_LOCATION "${_SNAPLOOM_CAPTURE_PREFIX}/lib/libsnaploom_capture.dylib")
  else()
    message(FATAL_ERROR "This Snaploom Capture SDK archive does not support the current platform")
  endif()
  set_target_properties(Snaploom::Capture PROPERTIES
    INTERFACE_INCLUDE_DIRECTORIES "${_SNAPLOOM_CAPTURE_PREFIX}/include")
endif()

if(NOT TARGET Snaploom::CaptureCpp)
  add_library(Snaploom::CaptureCpp INTERFACE IMPORTED)
  set_target_properties(Snaploom::CaptureCpp PROPERTIES
    INTERFACE_INCLUDE_DIRECTORIES "${_SNAPLOOM_CAPTURE_PREFIX}/include"
    INTERFACE_LINK_LIBRARIES Snaploom::Capture)
endif()

unset(_SNAPLOOM_CAPTURE_PREFIX)
