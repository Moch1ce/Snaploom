<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>12.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsTrimmable>true</IsTrimmable>
    <Deterministic>true</Deterministic>
    <DebugType>portable</DebugType>
    <PathMap>$(MSBuildProjectDirectory)=/_/sdk/dotnet/src/Snaploom.Capture</PathMap>

    <PackageId>Snaploom.Capture</PackageId>
    <Version>0.1.0</Version>
    <Authors>Snaploom contributors</Authors>
    <Description>Official .NET 8 wrapper for the Snaploom Capture C SDK.</Description>
    <PackageTags>screenshot;capture;native;interop</PackageTags>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/moch1ce/Snaploom</PackageProjectUrl>
    <RepositoryUrl>https://github.com/moch1ce/Snaploom</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="8.0.0" PrivateAssets="all" />
    <None Include="../../README.md" Pack="true" PackagePath="README.md" />
    <None Include="../../buildTransitive/Snaploom.Capture.targets" Pack="true" PackagePath="buildTransitive/Snaploom.Capture.targets" />
    <None Include="../../../distribution/NOTICE" Pack="true" PackagePath="" />
    <None Include="../../../distribution/THIRD-PARTY-NOTICES.txt" Pack="true" PackagePath="THIRD-PARTY-NOTICES.txt" />
    <None Include="../../sbom.cdx.json" Pack="true" PackagePath="sbom.cdx.json" />
    <None Include="../../../../LICENSES/Apache-2.0.txt" Pack="true" PackagePath="LICENSES/Apache-2.0.txt" />
    <None Include="$(SnaploomWindowsNativePath)" Pack="true" PackagePath="runtimes/win-x64/native/snaploom_capture.dll" Condition="'$(SnaploomWindowsNativePath)' != ''" />
    <None Include="$(SnaploomMacOSNativePath)" Pack="true" PackagePath="runtimes/osx-arm64/native/libsnaploom_capture.dylib" Condition="'$(SnaploomMacOSNativePath)' != ''" />
  </ItemGroup>

  <Target Name="RequireBothNativeAssetsForPack" BeforeTargets="Pack">
    <Error Condition="'$(SnaploomWindowsNativePath)' == '' Or !Exists('$(SnaploomWindowsNativePath)')" Text="SNAPLOOMPACK001: SnaploomWindowsNativePath must point to the staged win-x64 DLL." />
    <Error Condition="'$(SnaploomMacOSNativePath)' == '' Or !Exists('$(SnaploomMacOSNativePath)')" Text="SNAPLOOMPACK002: SnaploomMacOSNativePath must point to the staged osx-arm64 dylib." />
  </Target>
</Project>
