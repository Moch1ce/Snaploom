<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>Snaploom.App</AssemblyName>
    <RootNamespace>Snaploom.App</RootNamespace>
    <OutputType>WinExe</OutputType>
    <ApplicationTitle>Snaploom</ApplicationTitle>
    <ApplicationManifest>Platforms/Windows/app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Snaploom.Core/Snaploom.Core.csproj" />
    <ProjectReference Include="../Snaploom.Rendering/Snaploom.Rendering.csproj" />
    <ProjectReference Include="../Snaploom.Platform.Abstractions/Snaploom.Platform.Abstractions.csproj" />
    <ProjectReference Include="../Snaploom.Platform.Windows/Snaploom.Platform.Windows.csproj" />
    <ProjectReference Include="../Snaploom.Platform.MacOS/Snaploom.Platform.MacOS.csproj" />
  </ItemGroup>

  <Target
    Name="CreateMacOSApplicationBundle"
    AfterTargets="Publish"
    Condition="'$(RuntimeIdentifier)' == 'osx-arm64'">
    <PropertyGroup>
      <_MacOSBundleDirectory>$(PublishDir)bundle/Snaploom.app</_MacOSBundleDirectory>
      <_MacOSBundleRoot>$(_MacOSBundleDirectory)/Contents</_MacOSBundleRoot>
    </PropertyGroup>
    <RemoveDir Directories="$(PublishDir)bundle" />
    <ItemGroup>
      <_MacOSPublishedFile
        Include="$(PublishDir)**/*"
        Exclude="$(PublishDir)bundle/**/*" />
    </ItemGroup>
    <MakeDir Directories="$(_MacOSBundleRoot)/MacOS" />
    <Copy
      SourceFiles="@(_MacOSPublishedFile)"
      DestinationFiles="@(_MacOSPublishedFile->'$(_MacOSBundleRoot)/MacOS/%(RecursiveDir)%(Filename)%(Extension)')"
      SkipUnchangedFiles="true" />
    <Copy
      SourceFiles="$(MSBuildProjectDirectory)/Platforms/macOS/Info.plist"
      DestinationFolder="$(_MacOSBundleRoot)" />
  </Target>
</Project>
